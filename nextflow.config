manifest {
    name = 'JIAJZHAN-Kairos/immunelens-nf'
    author = 'Jiajun Zhan'
    description = 'Manifest-only ImmuneLENS WGS analysis for Seqera and AWS Batch'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version = '1.2.0'
}

params {
    input = null
    outdir = null
    help = false
    container = 'community.wave.seqera.io/library/r-base_samtools_awscli_python_pruned@sha256:b0bf56a001057922cea8f352bb6ec91d6891660515212f089e9683bc65f5115e'
}

params.outdir = params.outdir ?: "${params.input?.startsWith('s3://') ? params.input.substring(0, params.input.lastIndexOf('/')) : launchDir}/results/immunelens-${new Date().format('yyyyMMdd-HHmmss', TimeZone.getTimeZone('UTC'))}"

process {
    container = params.container
    shell = ['/bin/bash', '-euo', 'pipefail']
    cpus = 1
    memory = 4.GB
    time = 2.h
    errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
    maxRetries = 1

    withName: PREPARE_IMMUNELENS {
        cpus = 2
        memory = 8.GB
        time = 1.h
    }
    withName: EXTRACT_COVERAGE {
        cpus = 1
        memory = 4.GB
        time = 3.h
    }
    withName: FIT_IMMUNELENS {
        cpus = 2
        memory = { 8.GB * task.attempt }
        time = 6.h
    }
}

env {
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    AWS_DEFAULT_REGION = 'ap-southeast-2'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '--platform linux/amd64'
    }
    seqera {
        docker.enabled = true
        fusion.enabled = false
        wave.enabled = false
        aws.region = 'ap-southeast-2'
        // Seqera's compute environment supplies executor, queue, workDir and job role.
    }
    test {
        params.input = "${projectDir}/assets/samplesheet.example.csv"
        params.outdir = "${launchDir}/test-results"
    }
}

report { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
trace { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }
